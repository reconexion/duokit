{
  "name": "duokit-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Asistente de escritorio de duokit: descarga desde la compu del cliente en vez del servidor.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "node build.js"
  },
  "dependencies": {
    "tar": "^7.4.3",
