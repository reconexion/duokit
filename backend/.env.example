# Copia este archivo a backend/.env y rellena los valores. backend/.env NO se sube a git.

# Nombre del negocio que ven los clientes (recibos, panel). Usa un alias, NUNCA un nombre real.
SELLER_NAME=DuoKit

# A dónde mandar a alguien que necesita ayuda (soporte, perdió su contraseña y ya cerró sesión en todos lados).
# Es un contacto manual (tú, revisando ese chat), no un bot. Por defecto @tostilocos.
# SELLER_CONTACT=@tostilocos

# Dirección pública de la app: a donde Mercado Pago regresa al cliente después de pagar.
PUBLIC_URL=http://localhost:5173

# Cobro con tarjeta por Mercado Pago Checkout Pro. Sin MERCADOPAGO_ACCESS_TOKEN el sitio no vende ("Las compras no
# están disponibles por ahora"). Access token de "Tus integraciones" en el panel de Mercado Pago:
# TEST-... para probar, APP_USR-... cuando ya cobres de verdad.
MERCADOPAGO_ACCESS_TOKEN=
# "Clave secreta" del webhook (misma sección, Webhooks → Configurar notificaciones que apunte a
# /api/webhook/mercadopago). Es DISTINTA del access token. Sin esto, las compras se pueden iniciar pero NUNCA se
# confirman solas (el webhook siempre falla la firma) — usa /admin para confirmar a mano mientras tanto.
MERCADOPAGO_WEBHOOK_SECRET=

# Si publicas detrás de nginx/Cloudflare/Railway, para ver la IP real del cliente:
# TRUST_PROXY=1
# Ponlo SOLO si el backend no es accesible directamente desde internet (solo por el proxy); si no, cualquiera podría
# falsificar su IP con la cabecera X-Forwarded-For y saltarse los límites por IP.

# En hospedajes por contenedor (Railway y similares) hay que escuchar en todas las interfaces, no solo en este equipo:
# HOST=0.0.0.0

# --- Si YouTube bloquea las descargas desde tu servidor ("Sign in to confirm you're not a bot") ---
# Antes de tocar esto, entra a /admin y usa el diagnóstico (ver deploy/RAILWAY.md) para saber si de verdad hace falta.

# Cliente que finge ser yt-dlp ante YouTube. 'android' suele arreglar el bloqueo en servidores de nube, gratis.
# YTDLP_PLAYER_CLIENT=android

# Cookies de una cuenta de YouTube logueada, exportadas a un archivo (nunca subas ese archivo a git).
# YTDLP_COOKIES_FILE=/ruta/a/cookies.txt

# Proxy residencial de pago, si ni player_client ni cookies arreglan el bloqueo. Formato: http://usuario:contraseña@host:puerto
# (el proveedor te da esos datos al comprarlo). Cuesta dinero por GB descargado — no lo pongas sin confirmarlo antes.
# YTDLP_PROXY=

# Argumentos sueltos para probar algo puntual sin tocar código (separados por espacios; no acepta comillas).
# YTDLP_EXTRA_ARGS=

# --- Asistente de escritorio (helper/): descarga desde la compu del cliente, no desde este servidor ---
# Clave PRIVADA (Ed25519, PEM) para firmar los tickets de descarga que el Asistente verifica con su clave pública
# (helper/ticket-key.js). NUNCA subas la privada a git; la pública sí va en el código del Asistente a propósito.
# Genera un par nuevo con: node -e "const {publicKey,privateKey}=require('crypto').generateKeyPairSync('ed25519');
# console.log(privateKey.export({type:'pkcs8',format:'pem'})); console.log(publicKey.export({type:'spki',format:'pem'}))"
# Si generas una nueva, actualiza TAMBIÉN la clave pública en helper/ticket-key.js y reconstruye el Asistente.
DOWNLOAD_TICKET_PRIVATE_KEY=
