# Copia este archivo a backend/.env y rellena los valores. backend/.env NO se sube a git.

# Token del bot: créalo hablando con @BotFather en Telegram (/newbot) y pega aquí lo que te dé.
TELEGRAM_BOT_TOKEN=

# Usuario de Telegram del administrador (recibe los avisos de pago; debe escribirle /start al bot).
ADMIN_TELEGRAM=tostilocos

# (Opcional) ID numérico de Telegram del administrador. Si lo dejas vacío, se fija solo la primera vez que ese @usuario le
# escribe al bot; desde entonces solo esa cuenta puede confirmar pagos (aunque el @usuario cambie de dueño).
# Para conocer tu ID escríbele a @userinfobot.
ADMIN_TELEGRAM_ID=

# Dirección pública de la app: aparece en el mensaje con el acceso que recibe el cliente.
PUBLIC_URL=http://localhost:5173

# Cuenta donde el cliente hace la transferencia SPEI: tu CLABE (18 dígitos) o tu tarjeta de débito (16).
# Obligatoria: sin ella el bot no vende.
SELLER_ACCOUNT=

# Si publicas detrás de nginx/Cloudflare, para ver la IP real del cliente:
# TRUST_PROXY=1
# Ponlo SOLO si el backend no es accesible directamente desde internet (solo por el proxy); si no, cualquiera podría
# falsificar su IP con la cabecera X-Forwarded-For y saltarse los límites por IP.
